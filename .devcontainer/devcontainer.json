{
  "name": "Academic Helpdesk Agent",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "Academic Helpdesk",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/start-compose.sh"
}
