# For a VM accessed by its external IP, keep :80 and set ALLOWED_ORIGINS
# to http:// followed by that IP. For HTTPS, set a DNS name here and below.
SITE_ADDRESS=:80
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
ADMIN_API_TOKEN=

# The frontend and API are routed through the same origin by Caddy.
NEXT_PUBLIC_CHAT_API_URL=/api/chat
NEXT_PUBLIC_ADMIN_API_URL=/api
